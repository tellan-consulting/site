---
import { Font, getImage } from 'astro:assets';
import Logo from '../assets/logo.svg';
import { HOME_TITLE, NAV_LINKS, SITE_DESCRIPTION, SITE_NAME } from '../consts';
import defaultOgImage from '../assets/og-default.jpg';
import { getProduct } from '../lib/merch';
import '../styles/global.css';

interface Props {
  /** Page name; rendered as "<title> | Tellan". Omit on the home page. */
  title?: string;
  description?: string;
  /** Social card image (imported from src/assets). Defaults to og-default.jpg. */
  image?: ImageMetadata;
  lang?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = defaultOgImage,
  lang = 'en',
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE_NAME}` : HOME_TITLE;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: image, width: 1200, height: 630, format: 'jpg' });
const ogImageURL = new URL(ogImage.src, Astro.site);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
// The footer links to /merch only once a product is live (the page isn't built before).
const hasMerch = Boolean(await getProduct());
const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}

    <Font cssVariable="--font-google-sans" preload />
    <Font cssVariable="--font-inter" preload />

    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0f1111" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="container site-header">
      <a class="brand" href="/" aria-label={`${SITE_NAME} home`}>
        <Logo aria-hidden="true" />
      </a>
      <nav aria-label="Primary">
        <ul>
          {
            NAV_LINKS.map(({ href, label }) => (
              <li>
                <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="container">
      <p class="site-footer">
        &copy; {new Date().getFullYear()} {SITE_NAME}
        {
          hasMerch && (
            <>
              <span aria-hidden="true">&middot;</span>
              <a class="footer-link" href="/merch" aria-current={isCurrent('/merch') ? 'page' : undefined}>
                Merchandise
              </a>
            </>
          )
        }
      </p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-3);
  }

  .brand {
    /* Logo viewBox is 62.52 × 22.73; size it by height and the width follows. */
    --logo-height: 29.5px;
    display: inline-block;
    /* The η's descender (5.27 of the 22.73 units) hangs below the baseline. Pull it out of
       the header's vertical centring so the letters line up with the nav. */
    margin-bottom: calc(var(--logo-height) * -5.27 / 22.73);
  }

  .brand svg {
    width: auto;
    height: var(--logo-height);
    aspect-ratio: 62.52 / 22.73;
  }

  nav ul {
    display: flex;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--ash);
    font-size: var(--step--1);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--porcelain);
  }

  main:focus {
    outline: none;
  }

  .site-footer {
    max-width: none;
    padding-block: var(--space-3);
    border-top: 1px solid var(--ash-dark);
    color: var(--ash);
    font-size: var(--step--1);
  }

  .site-footer span {
    margin-inline: 0.2em;
  }

  .footer-link {
    color: var(--ash);
    text-decoration: none;
  }

  .footer-link:hover,
  .footer-link[aria-current='page'] {
    color: var(--porcelain);
  }
</style>
