---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/merch/ProductCard.astro';
import { getProducts, primaryPhoto } from '../../lib/merch';

const products = await getProducts();
---

<Base
  title="Merch"
  description="Tellan hats, made in small batches and shipped direct."
  image={products[0] ? primaryPhoto(products[0]).src : undefined}
>
  <section class="container page">
    <h1>Merch</h1>
    <p>Hats from Tellan, made in small batches and shipped direct.</p>

    {
      products.length ? (
        <ul class="grid" role="list">
          {products.map((product, i) => (
            <li>
              <ProductCard product={product} eager={i < 3} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">New merch is on the way. Check back soon.</p>
      )
    }
  </section>
</Base>

<style>
  .grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    margin-top: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .empty {
    color: var(--ash);
  }
</style>
