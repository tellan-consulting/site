---
import { Picture, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { formatPrice, getProduct, type Product } from '../../lib/merch';

// /merch is a rest route so it is only built when there is a product to sell: with no
// live product, getStaticPaths returns nothing and the page (and its sitemap entry) is skipped.
export async function getStaticPaths() {
  const product = await getProduct();
  return product ? [{ params: { root: undefined }, props: { product } }] : [];
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { name, summary, price, currency, image, paymentLink, available, status } = product.data;
const priceLabel = formatPrice(price, currency);
const statusLabel = status === 'draft' ? 'draft' : available ? 'available' : 'sold out';

// Structured data for search results. Same URL as the canonical link in Base.astro.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL((await getImage({ src: image.src, width: 1200, format: 'jpg' })).src, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  description: summary,
  image: imageUrl,
  url: pageUrl,
  sku: product.id,
  brand: { '@type': 'Brand', name: 'Tellan' },
  offers: {
    '@type': 'Offer',
    url: pageUrl,
    price: price.toFixed(2),
    priceCurrency: currency,
    availability: available ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
    itemCondition: 'https://schema.org/NewCondition',
  },
};
const jsonLdHtml = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<Base title={name} description={summary} image={image.src}>
  <script slot="head" type="application/ld+json" set:html={jsonLdHtml} />

  <section class="container merch">
    <figure class="photo">
      <Picture
        src={image.src}
        alt={image.alt}
        formats={['avif', 'webp']}
        widths={[600, 900, 1200]}
        sizes="(min-width: 40rem) 34rem, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </figure>

    <div class="line">
      <h1>{name}</h1>
      <p>{priceLabel}</p>
    </div>

    <div class="line rule">
      <p class="status">status: {statusLabel}</p>
      {available && <a class="buy" href={paymentLink}>buy<span aria-hidden="true"> →</span></a>}
    </div>
  </section>
</Base>

<style>
  /* One column, one photo, two lines of lowercase text. */
  .merch {
    --column: 34rem;
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    padding-block: clamp(var(--space-3), 2rem + 3vw, var(--space-4)) var(--space-4);
  }

  .photo,
  .line {
    width: min(100%, var(--column));
  }

  .photo {
    margin-bottom: var(--space-1);
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--carbon);
  }

  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-2);
    font-size: var(--step--1);
    text-transform: lowercase;
  }

  .line h1,
  .line p {
    max-width: none;
    font-family: inherit;
    font-size: inherit;
    font-weight: 400;
    line-height: inherit;
    letter-spacing: normal;
  }

  .line h1,
  .line p:not(.status) {
    color: var(--porcelain);
    font-variant-numeric: tabular-nums;
  }

  .rule {
    padding-top: var(--space-1);
    border-top: 1px solid var(--ash-dark);
  }

  .status {
    color: var(--ash);
  }

  .buy {
    color: var(--porcelain);
    text-decoration: none;
  }

  .buy:hover {
    text-decoration: underline;
  }
</style>
